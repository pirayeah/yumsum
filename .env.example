# Your Pinterest username (from pinterest.com/USERNAME/) and the board's address name.
# The board must be public. For pinterest.com/sara/yumsum/ that's:
PINTEREST_USERNAME=
PINTEREST_BOARD=yumsum

# AI: any OpenAI-compatible API. Default is Kimi K2.6 on NVIDIA's free tier;
# get a key at https://build.nvidia.com (it starts with nvapi-).
AI_API_KEY=
# AI_BASE_URL=https://integrate.api.nvidia.com/v1
# AI_MODEL=moonshotai/kimi-k2.6
